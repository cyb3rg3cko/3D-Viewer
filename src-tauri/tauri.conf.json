{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3D Viewer",
  "version": "0.2.0",
  "identifier": "com.cyb3rg3cko.threedviewer",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "3D Viewer",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "3D model viewer",
    "longDescription": "View GLB, FBX, VRM, and STL 3D models",
    "linux": {
      "deb": {
        "desktopTemplate": "desktop-template.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": ["glb", "gltf"],
        "name": "glTF 3D Model",
        "description": "glTF / GLB 3D model",
        "role": "Viewer",
        "mimeType": "model/gltf-binary"
      },
      {
        "ext": ["fbx"],
        "name": "Autodesk FBX",
        "description": "Autodesk FBX 3D model",
        "role": "Viewer",
        "mimeType": "application/octet-stream"
      },
      {
        "ext": ["vrm"],
        "name": "VRM Avatar",
        "description": "VRM humanoid avatar model",
        "role": "Viewer",
        "mimeType": "model/gltf-binary"
      },
      {
        "ext": ["stl"],
        "name": "STL Model",
        "description": "Stereolithography 3D model",
        "role": "Viewer",
        "mimeType": "model/stl"
      }
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
